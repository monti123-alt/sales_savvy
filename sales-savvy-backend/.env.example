# Copy to .env and fill in local credentials. Never commit .env.
DB_USERNAME=root
DB_PASSWORD=
DB_URL=jdbc:mysql://localhost:3306/sales_savvy?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SEED_DEMO_DATA=true

# Production admin bootstrap (required when SEED_DEMO_DATA=false)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# For local development; in production set this to your Vercel deployment origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SALESSAVVY_UPLOAD_DIR=uploads

# Optional integrations
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
